{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/api/gallery/upload/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/upload/(.*)",
      "headers": { "cache-control": "max-age=31536000" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
