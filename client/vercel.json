{
    "rewrites": [
      { "source": "/(.*)", "destination": "/index.html" },
      { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/**", "destination": "/index.html" }
    ],

    "routes": [
    { "src": "/(.*)", "dest": "/index.html" },
    { "src": "/admin", "dest": "/index.html"}
  ],
  "redirects": [
    {
      "source": "/admin/*",
      "destination": "/index.html",
      "statusCode": 200
    }
  ]
  }
  